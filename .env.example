# === Database Configuration ===
DATABASE_URL="postgresql://username:password@host:port/database_name?schema=public"
PORT=8585
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_NAME="rescue_system"

# === Redis Configuration ===
REDIS_URL="redis://localhost:6379"

# === JWT Configuration ===
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# === App Configuration ===
NODE_ENV=development

# === Mail Configuration ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM_NAME=RescueSystem

# === Cloudflare R2 Storage ===
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=your_public_bucket_url

# === Default Logo Fallbacks ===
DEFAULT_LOGO_PCCC="https://pub-your-bucket-url.r2.dev/assets/default-pccc.png"
DEFAULT_LOGO_YTE="https://pub-your-bucket-url.r2.dev/assets/default-yte.png"
DEFAULT_LOGO_VOLUNTEER="https://pub-your-bucket-url.r2.dev/assets/default-team.png"
DEFAULT_LOGO_GENERAL="https://pub-your-bucket-url.r2.dev/assets/default-volunteer.png"

# === Routing Service Configuration ===
# Options: "ORS" (OpenRouteService), "VALHALLA" (Self-hosted Valhalla), "OSRM" (OSRM Public API)
ROUTING_SERVICE=ORS
ORS_API_KEY=your_openrouteservice_api_key_here
VALHALLA_URL=http://localhost:8002
OSRM_URL=https://router.project-osrm.org/route/v1
