{
  "info": {
    "name": "Disaster Rescue Management System API",
    "description": "API documentation for Disaster Rescue Management System Backend. Base URL: http://localhost:3000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8585",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "url": "{{baseUrl}}/auth/login",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin.hcm@rescue.gov.vn\",\n    \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login with email or phone number"
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "url": "{{baseUrl}}/auth/register",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nguyễn Văn Test\",\n    \"phone\": \"0909123456\",\n    \"email\": \"test@example.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"123456789\",\n    \"dateOfBirth\": \"1990-01-01\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Register new citizen account"
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "url": "{{baseUrl}}/auth/refresh",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Refresh access token using refresh token"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "url": "{{baseUrl}}/auth/logout",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Logout and revoke refresh token"
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "url": "{{baseUrl}}/auth/forgot-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin@hcm.gov.vn\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Request OTP for password reset"
          }
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "url": "{{baseUrl}}/auth/reset-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resetToken\": \"uuid-from-forgot-password-response\",\n    \"otp\": \"123456\",\n    \"newPassword\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reset password with OTP and resetToken"
          }
        },
        {
          "name": "POST /auth/admin/register",
          "request": {
            "url": "{{baseUrl}}/auth/admin/register",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nhân viên Test\",\n    \"phone\": \"0912345678\",\n    \"email\": \"staff@test.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"987654321\",\n    \"dateOfBirth\": \"1990-05-15\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1,\n    \"roleId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Admin create staff account (requires auth)"
          }
        }
      ]
    },
    {
      "name": "2. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "url": "{{baseUrl}}/health",
            "method": "GET",
            "description": "Health check - public endpoint"
          }
        }
      ]
    },
    {
      "name": "3. Team Specializations",
      "description": "Team specialization management (CRUD operations)",
      "item": [
        {
          "name": "GET /team-specializations",
          "request": {
            "url": "{{baseUrl}}/team-specializations",
            "method": "GET",
            "description": "Get all team specializations (public)"
          }
        },
        {
          "name": "GET /team-specializations?teamType=Y_TE",
          "request": {
            "url": "{{baseUrl}}/team-specializations?teamType=Y_TE",
            "method": "GET",
            "description": "Get specializations filtered by team type"
          }
        },
        {
          "name": "GET /team-specializations?isActive=true",
          "request": {
            "url": "{{baseUrl}}/team-specializations?isActive=true",
            "method": "GET",
            "description": "Get only active specializations"
          }
        },
        {
          "name": "GET /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/1",
            "method": "GET",
            "description": "Get team specialization details by ID"
          }
        },
        {
          "name": "POST /team-specializations",
          "request": {
            "url": "{{baseUrl}}/team-specializations",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Phòng cháy chữa cháy\",\n    \"teamType\": \"PCCC\",\n    \"description\": \"Chuyên môn phòng cháy chữa cháy\",\n    \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a new team specialization"
          }
        },
        {
          "name": "PATCH /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/1",
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Phòng cháy chữa cháy - Updated\",\n    \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update team specialization"
          }
        },
        {
          "name": "DELETE /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/5",
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "description": "Delete team specialization (soft delete)"
          }
        }
      ]
    },
    {
      "name": "4. Rescue Teams",
      "description": "Rescue Team Management - Hỗ trợ cả đội chuyên nghiệp (PROFESSIONAL) và đội tự phát (VOLUNTEER_SPONTANEOUS)",
      "item": [
        {
          "name": "4.1 QUICK FLOW - VOLUNTEER_SPONTANEOUS (Khẩn cấp)",
          "description": "Flow nhanh cho tình huống khẩn cấp - không cần teamType, chỉ cần tên + vị trí + leader",
          "item": [
            {
              "name": "4.1.1 Tạo đội tự phát (không cần teamType)",
              "request": {
                "url": "{{baseUrl}}/rescue-teams",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội cứu hộ tự phát quận 5\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 15\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Tạo đội tự phát - chỉ cần name, provinceId, adminUnitId. Không bắt buộc teamType, specializationIds."
              }
            },
            {
              "name": "4.1.2 Thêm LEADER là công dân (citizen - không cần userId)",
              "request": {
                "url": "{{baseUrl}}/teams/1/members",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"citizenName\": \"Trần Văn Lớn\",\n    \"citizenPhone\": \"0987654321\",\n    \"roleInTeam\": \"LEADER\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Thêm leader là công dân bình thường - hệ thống tự lưu leaderCitizenName + leaderPhone"
              }
            },
            {
              "name": "4.1.3 Thêm thành viên là công dân",
              "request": {
                "url": "{{baseUrl}}/teams/1/members",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"citizenName\": \"Nguyễn Thị Một\",\n    \"citizenPhone\": \"0912345001\",\n    \"roleInTeam\": \"MEMBER\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Thêm thành viên là công dân - chỉ cần citizenName + citizenPhone"
              }
            },
            {
              "name": "4.1.4 Cập nhật vị trí đội (GPS)",
              "request": {
                "url": "{{baseUrl}}/rescue-teams/1/location",
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"currentLocation\": {\n        \"type\": \"Point\",\n        \"coordinates\": [106.7004, 10.7589]\n    },\n    \"status\": \"AVAILABLE\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Cập nhật vị trí hiện tại của đội để hệ thống theo dõi"
              }
            },
            {
              "name": "4.1.5 Xem danh sách thành viên",
              "request": {
                "url": "{{baseUrl}}/teams/1/members?isActive=true",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Xem danh sách thành viên đang hoạt động trong đội"
              }
            }
          ]
        },
        {
          "name": "4.2 PROFESSIONAL - Đội chuyên nghiệp (PCCC, Y_TE...)",
          "description": "Flow cho đội chuyên nghiệp - cần teamType + specializationIds",
          "item": [
            {
              "name": "4.2.1 Tạo đội PCCC với chuyên môn",
              "request": {
                "url": "{{baseUrl}}/rescue-teams",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội PCCC Quận 1\",\n    \"teamType\": \"PCCC\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 20,\n    \"specializationIds\": [1, 2]\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Tạo đội PCCC chuyên nghiệp - bắt buộc teamType + specializationIds (validate teamType match)"
              }
            },
            {
              "name": "4.2.2 Thêm LEADER là user đã đăng ký",
              "request": {
                "url": "{{baseUrl}}/teams/1/members",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"userId\": 5,\n    \"roleInTeam\": \"LEADER\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Thêm leader là user đã có tài khoản trong hệ thống"
              }
            },
            {
              "name": "4.2.3 Thêm thành viên là user",
              "request": {
                "url": "{{baseUrl}}/teams/1/members",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"userId\": 6,\n    \"roleInTeam\": \"MEMBER\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Thêm thành viên đã có tài khoản"
              }
            }
          ]
        },
        {
          "name": "4.3 Team CRUD (Common)",
          "item": [
            {
              "name": "GET /rescue-teams - List all",
              "request": {
                "url": "{{baseUrl}}/rescue-teams?page=1&limit=20",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Lấy danh sách tất cả đội cứu hộ (phân trang)"
              }
            },
            {
              "name": "GET /rescue-teams?provinceId=1&status=AVAILABLE",
              "request": {
                "url": "{{baseUrl}}/rescue-teams?provinceId=1&status=AVAILABLE",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Lọc đội theo tỉnh + trạng thái sẵn sàng"
              }
            },
            {
              "name": "GET /rescue-teams?search=PCCC",
              "request": {
                "url": "{{baseUrl}}/rescue-teams?search=PCCC",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Tìm kiếm đội theo tên"
              }
            },
            {
              "name": "GET /rescue-teams/:teamId",
              "request": {
                "url": "{{baseUrl}}/rescue-teams/1",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Xem chi tiết một đội"
              }
            },
            {
              "name": "PATCH /rescue-teams/:teamId",
              "request": {
                "url": "{{baseUrl}}/rescue-teams/1",
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"name\": \"Đội PCCC Quận 1 - Cập nhật\",\n    \"status\": \"STANDBY\",\n    \"maxCapacity\": 25\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Cập nhật thông tin đội"
              }
            },
            {
              "name": "PATCH /rescue-teams/:teamId/location",
              "request": {
                "url": "{{baseUrl}}/rescue-teams/1/location",
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"currentLocation\": {\n        \"type\": \"Point\",\n        \"coordinates\": [106.7004, 10.7589]\n    },\n    \"status\": \"AVAILABLE\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "description": "Cập nhật vị trí GPS + trạng thái"
              }
            },
            {
              "name": "DELETE /rescue-teams/:teamId",
              "request": {
                "url": "{{baseUrl}}/rescue-teams/1",
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Xóa đội (chỉ khi không còn thành viên active)"
              }
            }
          ]
        },
        {
          "name": "4.4 Member Management",
          "item": [
            {
              "name": "GET /rescue-teams/:teamId/members",
              "request": {
                "url": "{{baseUrl}}/teams/1/members?isActive=true",
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
                ],
                "description": "Lấy danh sách thành viên (lọc theo isActive)"
              }
            },
            {
              "name": "PATCH /rescue-teams/:teamId/members/:memberId/role",
              "request": {
                "url": "{{baseUrl}}/teams/1/members/5/role",
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"roleInTeam\": \"DEPUTY_LEADER\"\n}",
