{
  "info": {
    "name": "Disaster Rescue Management System API",
    "description": "API documentation for Disaster Rescue Management System Backend. Base URL: http://localhost:3000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8585",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "url": "{{baseUrl}}/auth/login",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin.hcm@rescue.gov.vn\",\n    \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login with email or phone number"
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "url": "{{baseUrl}}/auth/register",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nguyễn Văn Test\",\n    \"phone\": \"0909123456\",\n    \"email\": \"test@example.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"123456789\",\n    \"dateOfBirth\": \"1990-01-01\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1,\n    \"isVolunteer\": true,\n    \"needsHelp\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Register new citizen account"
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "url": "{{baseUrl}}/auth/refresh",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Refresh access token using refresh token"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "url": "{{baseUrl}}/auth/logout",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Logout and revoke refresh token"
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "url": "{{baseUrl}}/auth/forgot-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin@hcm.gov.vn\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Request OTP for password reset"
          }
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "url": "{{baseUrl}}/auth/reset-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resetToken\": \"uuid-from-forgot-password-response\",\n    \"otp\": \"123456\",\n    \"newPassword\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reset password with OTP and resetToken"
          }
        },
        {
          "name": "POST /auth/admin/register",
          "request": {
            "url": "{{baseUrl}}/auth/admin/register",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nhân viên Test\",\n    \"phone\": \"0912345678\",\n    \"email\": \"staff@test.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"987654321\",\n    \"dateOfBirth\": \"1990-05-15\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1,\n    \"roleId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Admin create staff account (requires auth)"
          }
        }
      ]
    },
    {
      "name": "2. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "url": "{{baseUrl}}/health",
            "method": "GET",
            "description": "Health check - public endpoint"
          }
        }
      ]
    },
    {
      "name": "3. Users",
      "description": "User management endpoints",
      "item": [
        {
          "name": "GET /users - Danh sách người dùng",
          "request": {
            "url": "{{baseUrl}}/users?page=1&limit=20",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy danh sách người dùng (phân trang)"
          }
        },
        {
          "name": "GET /users/search?q=",
          "request": {
            "url": "{{baseUrl}}/users/search?q=nguyen",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Tìm kiếm người dùng theo tên, số điện thoại, email"
          }
        },
        {
          "name": "GET /users/profile",
          "request": {
            "url": "{{baseUrl}}/users/profile",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy thông tin cá nhân của user đang đăng nhập"
          }
        },
        {
          "name": "PATCH /users/profile - Cập nhật thông tin cá nhân",
          "request": {
            "url": "{{baseUrl}}/users/profile",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nguyễn Văn A - Updated\",\n    \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật thông tin cá nhân"
          }
        },
        {
          "name": "GET /users/:id",
          "request": {
            "url": "{{baseUrl}}/users/1",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy thông tin người dùng theo ID"
          }
        },
        {
          "name": "PATCH /users/:id - Cập nhật người dùng",
          "request": {
            "url": "{{baseUrl}}/users/1",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nguyễn Văn B\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật thông tin người dùng"
          }
        },
        {
          "name": "PATCH /users/:id/status - Kích hoạt/Vô hiệu hóa",
          "request": {
            "url": "{{baseUrl}}/users/1/status",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"isActive\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Kích hoạt hoặc vô hiệu hóa tài khoản người dùng"
          }
        },
        {
          "name": "PATCH /users/:id/password - Đổi mật khẩu",
          "request": {
            "url": "{{baseUrl}}/users/1/password",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"newPassword\": \"NewPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Admin đổi mật khẩu người dùng"
          }
        },
        {
          "name": "DELETE /users/:id - Xóa người dùng",
          "request": {
            "url": "{{baseUrl}}/users/1",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xóa người dùng (soft delete)"
          }
        }
      ]
    },
    {
      "name": "4. Rescue Teams",
      "description": "Rescue Team CRUD at /rescue-teams",
      "item": [
        {
          "name": "POST /rescue-teams - Tạo đội cứu hộ",
          "request": {
            "url": "{{baseUrl}}/rescue-teams",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội PCCC Quận 1\",\n    \"teamType\": \"PCCC\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 20,\n    \"specializationIds\": [1, 2]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Tạo đội cứu hộ chuyên nghiệp (bắt buộc teamType + specializationIds)"
          }
        },
        {
          "name": "POST /rescue-teams - Tạo đội tự phát (không cần teamType)",
          "request": {
            "url": "{{baseUrl}}/rescue-teams",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội cứu hộ tự phát quận 5\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 15\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Tạo đội tự phát - không bắt buộc teamType, specializationIds"
          }
        },
        {
          "name": "GET /rescue-teams - Danh sách đội",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?page=1&limit=20",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy danh sách tất cả đội cứu hộ (phân trang)"
          }
        },
        {
          "name": "GET /rescue-teams?provinceId=1&status=AVAILABLE",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?provinceId=1&status=AVAILABLE",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lọc đội theo tỉnh + trạng thái sẵn sàng"
          }
        },
        {
          "name": "GET /rescue-teams?search=PCCC",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?search=PCCC",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Tìm kiếm đội theo tên"
          }
        },
        {
          "name": "GET /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xem chi tiết một đội"
          }
        },
        {
          "name": "PATCH /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Đội PCCC Quận 1 - Cập nhật\",\n    \"status\": \"STANDBY\",\n    \"maxCapacity\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật thông tin đội"
          }
        },
        {
          "name": "PATCH /rescue-teams/:teamId/location",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1/location",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentLocation\": {\n        \"type\": \"Point\",\n        \"coordinates\": [106.7004, 10.7589]\n    },\n    \"status\": \"AVAILABLE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật vị trí GPS + trạng thái"
          }
        },
        {
          "name": "DELETE /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xóa đội (chỉ khi không còn thành viên active)"
          }
        }
      ]
    },
    {
      "name": "5. Team Members",
      "description": "Member management - /teams/:teamId/members",
      "item": [
        {
          "name": "POST /teams/:teamId/members - Thêm thành viên (user có tài khoản)",
          "request": {
            "url": "{{baseUrl}}/teams/1/members",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 5,\n    \"roleInTeam\": \"MEMBER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thêm thành viên là user đã có tài khoản. VALIDATIONS: userId phải tồn tại, user chưa thuộc đội này, LEADER phải là user (không citizen)"
          }
        },
        {
          "name": "POST /teams/:teamId/members - Thêm thành viên (citizen - không có tài khoản)",
          "request": {
            "url": "{{baseUrl}}/teams/1/members",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"citizenName\": \"Trần Văn Lớn\",\n    \"citizenPhone\": \"0987654321\",\n    \"roleInTeam\": \"MEMBER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thêm công dân không có tài khoản. VALIDATIONS: citizenName+bát buộc, citizenName+citizenPhone chưa tồn tại trong team, citizen không thể là LEADER"
          }
        },
        {
          "name": "POST /teams/:teamId/members - Thêm LEADER (userId bắt buộc)",
          "request": {
            "url": "{{baseUrl}}/teams/1/members",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 6,\n    \"roleInTeam\": \"LEADER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thêm LEADER cho đội - bắt buộc userId, LEADER không thể là citizen"
          }
        },
        {
          "name": "GET /teams/:teamId/members - Danh sách thành viên",
          "request": {
            "url": "{{baseUrl}}/teams/1/members?isActive=true",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy danh sách thành viên (lọc theo isActive, roleInTeam)"
          }
        },
        {
          "name": "PATCH /teams/:teamId/members/:memberId/role - Thăng/hạ chức",
          "request": {
            "url": "{{baseUrl}}/teams/1/members/5/role",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleInTeam\": \"DEPUTY_LEADER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thăng/hạ chức thành viên (MEMBER -> DEPUTY_LEADER -> LEADER). VALIDATIONS: citizen không thể lên LEADER, chỉ có 1 LEADER trong team"
          }
        },
        {
          "name": "DELETE /teams/:teamId/members/:memberId - Xóa thành viên",
          "request": {
            "url": "{{baseUrl}}/teams/1/members/5",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xóa thành viên khỏi đội (soft delete). Chỉ user có account mới có thể bị xóa, citizen không thể leaveTeam"
          }
        },
        {
          "name": "POST /teams/leave - Rời đội",
          "request": {
            "url": "{{baseUrl}}/teams/leave",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "User tự rời đội (dùng userId từ JWT)"
          }
        }
      ]
    },
