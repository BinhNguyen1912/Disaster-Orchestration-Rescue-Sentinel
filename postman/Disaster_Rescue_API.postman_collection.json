    {
      "name": "6. Team Specializations",
      "description": "Team specialization management for rescue teams",
      "item": [
        {
          "name": "GET /team-specializations",
          "request": {
            "url": "{{baseUrl}}/team-specializations",
            "method": "GET",
            "description": "Get all team specializations (filter by teamType, isActive)"
          }
        },
        {
          "name": "GET /team-specializations?teamType=PCCC&isActive=true",
          "request": {
            "url": "{{baseUrl}}/team-specializations?teamType=PCCC&isActive=true",
            "method": "GET",
            "description": "Get active PCCC specializations"
          }
        },
        {
          "name": "GET /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/1",
            "method": "GET",
            "description": "Get specialization by ID"
          }
        },
        {
          "name": "POST /team-specializations",
          "request": {
            "url": "{{baseUrl}}/team-specializations",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
