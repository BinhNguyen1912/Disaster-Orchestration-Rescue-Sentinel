{
  "info": {
    "name": "Disaster Rescue Management System API",
    "description": "API documentation for Disaster Rescue Management System Backend. Base URL: http://localhost:3000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8585",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "url": "{{baseUrl}}/auth/login",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin.hcm@rescue.gov.vn\",\n    \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login with email or phone number"
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "url": "{{baseUrl}}/auth/register",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nguyễn Văn Test\",\n    \"phone\": \"0909123456\",\n    \"email\": \"test@example.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"123456789\",\n    \"dateOfBirth\": \"1990-01-01\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Register new citizen account"
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "url": "{{baseUrl}}/auth/refresh",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Refresh access token using refresh token"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "url": "{{baseUrl}}/auth/logout",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Logout and revoke refresh token"
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "url": "{{baseUrl}}/auth/forgot-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin@hcm.gov.vn\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Request OTP for password reset"
          }
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "url": "{{baseUrl}}/auth/reset-password",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resetToken\": \"uuid-from-forgot-password-response\",\n    \"otp\": \"123456\",\n    \"newPassword\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reset password with OTP and resetToken"
          }
        },
        {
          "name": "POST /auth/admin/register",
          "request": {
            "url": "{{baseUrl}}/auth/admin/register",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Nhân viên Test\",\n    \"phone\": \"0912345678\",\n    \"email\": \"staff@test.com\",\n    \"password\": \"123123\",\n    \"nationalId\": \"987654321\",\n    \"dateOfBirth\": \"1990-05-15\",\n    \"gender\": \"MALE\",\n    \"provinceId\": 1,\n    \"roleId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Admin create staff account (requires auth)"
          }
        }
      ]
    },
    {
      "name": "2. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "url": "{{baseUrl}}/health",
            "method": "GET",
            "description": "Health check - public endpoint"
          }
        }
      ]
    },
    {
      "name": "3. Rescue Teams",
      "description": "Rescue Team CRUD at /rescue-teams",
      "item": [
        {
          "name": "POST /rescue-teams - Tạo đội cứu hộ",
          "request": {
            "url": "{{baseUrl}}/rescue-teams",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội PCCC Quận 1\",\n    \"teamType\": \"PCCC\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 20,\n    \"specializationIds\": [1, 2]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Tạo đội cứu hộ chuyên nghiệp (bắt buộc teamType + specializationIds)"
          }
        },
        {
          "name": "POST /rescue-teams - Tạo đội tự phát (không cần teamType)",
          "request": {
            "url": "{{baseUrl}}/rescue-teams",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provinceId\": 1,\n    \"name\": \"Đội cứu hộ tự phát quận 5\",\n    \"adminUnitId\": 1,\n    \"maxCapacity\": 15\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Tạo đội tự phát - không bắt buộc teamType, specializationIds"
          }
        },
        {
          "name": "GET /rescue-teams - Danh sách đội",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?page=1&limit=20",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy danh sách tất cả đội cứu hộ (phân trang)"
          }
        },
        {
          "name": "GET /rescue-teams?provinceId=1&status=AVAILABLE",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?provinceId=1&status=AVAILABLE",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lọc đội theo tỉnh + trạng thái sẵn sàng"
          }
        },
        {
          "name": "GET /rescue-teams?search=PCCC",
          "request": {
            "url": "{{baseUrl}}/rescue-teams?search=PCCC",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Tìm kiếm đội theo tên"
          }
        },
        {
          "name": "GET /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xem chi tiết một đội"
          }
        },
        {
          "name": "PATCH /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Đội PCCC Quận 1 - Cập nhật\",\n    \"status\": \"STANDBY\",\n    \"maxCapacity\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật thông tin đội"
          }
        },
        {
          "name": "PATCH /rescue-teams/:teamId/location",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1/location",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentLocation\": {\n        \"type\": \"Point\",\n        \"coordinates\": [106.7004, 10.7589]\n    },\n    \"status\": \"AVAILABLE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cập nhật vị trí GPS + trạng thái"
          }
        },
        {
          "name": "DELETE /rescue-teams/:teamId",
          "request": {
            "url": "{{baseUrl}}/rescue-teams/1",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xóa đội (chỉ khi không còn thành viên active)"
          }
        }
      ]
    },
    {
      "name": "4. Team Members",
      "description": "Member management - /teams/:teamId/members",
      "item": [
        {
          "name": "POST /teams/:teamId/members - Thêm thành viên (user)",
          "request": {
            "url": "{{baseUrl}}/teams/1/members",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 5,\n    \"roleInTeam\": \"LEADER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thêm thành viên là user đã có tài khoản"
          }
        },
        {
          "name": "POST /teams/:teamId/members - Thêm thành viên (citizen)",
          "request": {
            "url": "{{baseUrl}}/teams/1/members",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"citizenName\": \"Trần Văn Lớn\",\n    \"citizenPhone\": \"0987654321\",\n    \"roleInTeam\": \"LEADER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thêm thành viên là công dân (không cần userId)"
          }
        },
        {
          "name": "GET /teams/:teamId/members - Danh sách thành viên",
          "request": {
            "url": "{{baseUrl}}/teams/1/members?isActive=true",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Lấy danh sách thành viên (lọc theo isActive)"
          }
        },
        {
          "name": "PATCH /teams/:teamId/members/:memberId/role",
          "request": {
            "url": "{{baseUrl}}/teams/1/members/5/role",
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleInTeam\": \"DEPUTY_LEADER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Thăng/hạ chức thành viên (MEMBER -> DEPUTY_LEADER -> LEADER)"
          }
        },
        {
          "name": "DELETE /teams/:teamId/members/:memberId",
          "request": {
            "url": "{{baseUrl}}/teams/1/members/5",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "Xóa thành viên khỏi đội (soft delete)"
          }
        },
        {
          "name": "POST /teams/leave - Rời đội",
          "request": {
            "url": "{{baseUrl}}/teams/leave",
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "description": "User tự rời đội (dùng userId từ JWT)"
          }
        }
      ]
    },
    {
      "name": "5. Location",
      "description": "Province and Ward/Commune endpoints for dropdown selections and map",
      "item": [
        {
          "name": "GET /locations/provinces",
          "request": {
            "url": "{{baseUrl}}/locations/provinces",
            "method": "GET",
            "description": "Get all provinces for dropdown (ordered by name)"
          }
        },
        {
          "name": "GET /locations/provinces/:id",
          "request": {
            "url": "{{baseUrl}}/locations/provinces/1",
            "method": "GET",
            "description": "Get province details by ID"
          }
        },
        {
          "name": "GET /locations/provinces/:id/center",
          "request": {
            "url": "{{baseUrl}}/locations/provinces/1/center",
            "method": "GET",
            "description": "Get province center coordinates (lat/lng) for map centering"
          }
        },
        {
          "name": "GET /locations/wards?provinceId=1",
          "request": {
            "url": "{{baseUrl}}/locations/wards?provinceId=1",
            "method": "GET",
            "description": "Get wards/communes by province ID for dependent dropdown"
          }
        }
      ]
    },
    {
      "name": "6. Team Specializations",
      "description": "Team specialization management for rescue teams",
      "item": [
        {
          "name": "GET /team-specializations",
          "request": {
            "url": "{{baseUrl}}/team-specializations",
            "method": "GET",
            "description": "Get all team specializations (filter by teamType, isActive)"
          }
        },
        {
          "name": "GET /team-specializations?teamType=PCCC&isActive=true",
          "request": {
            "url": "{{baseUrl}}/team-specializations?teamType=PCCC&isActive=true",
            "method": "GET",
            "description": "Get active PCCC specializations"
          }
        },
        {
          "name": "GET /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/1",
            "method": "GET",
            "description": "Get specialization by ID"
          }
        },
