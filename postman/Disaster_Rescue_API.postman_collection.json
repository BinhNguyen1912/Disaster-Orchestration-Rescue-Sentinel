            },
            {
              "name": "POST /rescue-teams/leave",
              "request": {
                "url": "{{baseUrl}}/teams/leave",
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}",
                  "options": { "raw": { "language": "json" } }
                },
