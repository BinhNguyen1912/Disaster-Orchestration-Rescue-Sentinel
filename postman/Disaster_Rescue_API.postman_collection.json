            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Cứu hộ bùn lầy - Updated\",\n    \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update team specialization"
          }
        },
        {
          "name": "DELETE /team-specializations/:id",
          "request": {
            "url": "{{baseUrl}}/team-specializations/1",
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "description": "Soft delete team specialization"
          }
        }
      ]
    },
